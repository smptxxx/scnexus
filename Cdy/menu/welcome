clear
echo -e "\e[1;96m┌─────────────────────────────────────────────────┐\e[0m"
echo -e "\033[96;1m│             \e[36m.::.\033[0m \033[0;35m  SCRIPT TUNNEL \033[0m \e[36m.::.\033[0m           \033[96;1m │\e[0m"
echo -e "\e[1;96m└─────────────────────────────────────────────────┘\e[0m"
}

function Service_System_Operating() {
echo -e "${z}┌─────────────────────────────────────────────────┐\033[0m "
echo -e "${z}│${NC} \e[36mSYSTEM          : $(cat /etc/os-release | grep -w PRETTY_NAME | head -n1 | sed 's/=//g' | sed 's/"//g' | sed 's/PRETTY_NAME//g')     \033[0m "
echo -e "${z}│${NC} \e[36mRAM             : $(free -m | awk 'NR==2 {print $2}')    \033[0m "
echo -e "${z}│${NC} \e[36mUPTIME          : $(uptime -p | cut -d " " -f 2-10)\033[0m "
echo -e "${z}│${NC} \e[36mIP VPS          : ${MYIP}     \033[0m "
echo -e "${z}│${NC} \e[36mCITY            : ${CITY}    \033[0m "
echo -e "${z}│${NC} \e[36mISP             : ${ISP}    \033[0m "
echo -e "${z}│${NC} \e[36mDOMAIN          : ${domain}    \033[0m "
echo -e "${z}│${NC} \e[36mYOUR PING       : ${ping_ms} ms    \033[0m"
echo -e "${z}└─────────────────────────────────────────────────┘\033[0m"
}

function Service_Status() {
echo -e "\033[96;1m┌─────────────────────────────────────────────────┐\033[0m "
echo -e "\033[96;1m|\e[0m \e[36mPROXY :\e[0m $status_haproxy \e[96;1m|\e[0m \e[0m \e[36mNGINX :\e[0m $status_nginx \e[96;1m|\e[0m \e[0m \e[36mXRAY :\e[0m $status_xray \e[0m| $status_dropbear  \e[96;1m  | \e[0m "
echo -e "\033[96;1m└─────────────────────────────────────────────────┘\033[0m "
}

function List_All_Account() {
echo -e "${z}     ┌───────────────────────────────────────┐\033[0m "
echo -e "              \e[36mSSH OPENVPN    :     $ssh1         \033[0m "
echo -e "              \e[36mVLESS XRAY     :     $vla          \033[0m "
echo -e "              \e[36mVMESS XRAY     :     $vma          \033[0m "
echo -e "              \e[36mTRJAN XRAY     :     $trb          \033[0m "
echo -e "              \e[36mSSR-LIBEV      :     $ssa          \033[0m "
echo -e "${z}     └───────────────────────────────────────┘\033[0m "
}

function Details_Clients_Name() {
echo -e "${z}   ┌───────────────────────────────────────────┐\033[0m "
echo -e "${z}   │${NC}  \e[36mVERSION     : ${BLUE}4.0 LTS \033[0m "
echo -e "${z}   │${NC}  \e[36mCLIENTS     :\033[0m\033[92;1m $(cat /usr/bin/user)   \033[0m "
echo -e "${z}   │${NC}  \e[36mExpiry In   :\033[0m\033[92;1m $masaaktif  \033[0m "
echo -e "${z}   └───────────────────────────────────────────┘\033[0m "
}

function Details_Bw_Clients() {
echo -e "${z}   ┌───────────────────────────────────────────┐\033[0m "

function center_text() {
    local text="$1"
    local width=50  # Sesuaikan dengan panjang baris yang diinginkan
    local plain_text=$(echo -e "$text" | sed 's/\x1b\[[0-9;]*m//g')
    local len=${#plain_text}
    local spaces=$(( (width - len) / 2 ))
    printf "%${spaces}s%s\033[0m\n" "" "$(echo -e "$text")"
}

formatted_text="\e[36mKEMARIN  |  HARI INI  |  BULANAN\033[0m"
formatted_text1="\033[91;1m${bwkmrn1}   ${bwhari}     ${bwbln}\033[0m"
center_text "$formatted_text"
center_text "$formatted_text1"
echo -e "${z}   └───────────────────────────────────────────┘\033[0m "
}

function Acces_Use_Command() {
