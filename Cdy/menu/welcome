echo -e "${z}         Press Enter to access the menu...       ${NC} "
echo -e "${z} —————————————————————————————————————————————————${NC}"
  read -p ""
  menu
}

rif_Banner
Service_System_Operating
Service_Status
List_All_Account
Details_Clients_Name
Details_Bw_Clients
Acces_Use_Command